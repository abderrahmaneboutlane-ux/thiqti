{
  "name": "thiqti",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build -w apps/web && node copy-static.js",
    "start": "node apps/web/.next/standalone/server.js",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/api",
    "test": "npm run test -w apps/web",
    "test:watch": "npm run test:watch -w apps/web",
    "test:coverage": "npm run test:coverage -w apps/web",
    "test:nlp": "node tests.js",
    "test:validate": "node check.js",
    "test:e2e": "npm run test:e2e -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "react-is": "^19.2.8",
    "rxjs": "^7.8.2"
  }
}
